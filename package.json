{
  "name": "stream-good-puppy-point-widget",
  "version": "0.1.0",
  "description": "A StreamElements widget for Twitch and YouTube that pops a Good Puppy point star on screen and keeps a running total.",
  "license": "MIT",
  "author": "wielorzeczownik",
  "homepage": "https://github.com/wielorzeczownik/stream-good-puppy-point-widget#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wielorzeczownik/stream-good-puppy-point-widget.git"
  },
  "bugs": {
    "url": "https://github.com/wielorzeczownik/stream-good-puppy-point-widget/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite --mode development",
    "build": "vite build && tixyel b -b none",
    "compile": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint widget/src/scripts widget/src/index.html tests",
    "lint:scss": "stylelint \"widget/src/styles/**/*.scss\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "fix": "eslint --fix widget/src/scripts widget/src/index.html tests && stylelint --fix \"widget/src/styles/**/*.scss\" && prettier --write ."
  },
  "devDependencies": {
    "@html-eslint/eslint-plugin": "0.69.0",
    "@html-eslint/parser": "0.69.0",
    "@tixyel/cli": "3.7.0",
    "@types/node": "26.6.11",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.9",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "4.2.3",
    "eslint-plugin-unicorn": "80.0.0",
    "jiti": "2.7.0",
    "prettier": "3.10.1",
    "rollup-plugin-external-globals": "0.13.0",
    "sass": "1.108.2",
    "stylelint": "18.1.0",
    "stylelint-config-recess-order": "7.10.1",
    "stylelint-config-standard-scss": "18.0.0",
    "stylelint-order": "8.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "5.1.2"
  },
  "dependencies": {
    "@tixyel/streamelements": "7.15.0",
    "motion": "14.14.0"
  }
}
